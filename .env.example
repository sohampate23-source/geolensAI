# GeoLens AI Environment Configuration Example
# Copy this file to .env and provide your credentials as needed.
# The application runs fully in DEMO_MODE with deterministic local fallbacks without any API keys.

# OpenRouter (LLM Query Planning)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_S=30
OPENROUTER_MAX_RETRIES=2
OPENROUTER_RUN_LIVE_TESTS=true

# Sarvam AI (Indian-Language Translation: English, Hindi, Marathi)
SARVAM_API_KEY=

# Jev AI (Candidate Ranking Adapter - Optional)
JEV_API_KEY=
JEV_API_ENDPOINT=
JEV_MODEL=
JEV_ENABLED=false

# SkyCLIP / SkyScript (Vision Retrieval Checkpoint)
SKYCLIP_WEIGHTS=data/embeddings/skyclip_weights.pt

# Spatial Engine Feature Toggles
FEATURE_NEGATE=true
FEATURE_MIN_AREA=true
DEMO_MODE=true
FEATURE_DETECTION_CACHE=false
